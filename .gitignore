.vite/

# Environment & Secrets
.env
.env.*
!.env.example
!config/**/.env.example
*.pem
*.key
*.crt
*.pfx
security/secrets/
!security/secrets.example/**

# Models & Large Checkpoints (Local-only, do not commit)
/models/
!ai/models/**
ai/models/**/__pycache__/
*.gguf
*.onnx
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.npz
*.tar.gz
*.zip
data/raw/
data/datasets/
wav2vec2_checkpoints/

# Database & Vectors
database/*.db*
database/*.sqlite*
database/*.faiss
database/backups/*
!database/backups/.gitkeep
data/index/*
!data/index/.gitkeep
rag/vectorstore/*
!rag/vectorstore/.gitkeep

# Audio temporary files (Strict zero-persistence rule)
*.wav
*.mp3
*.ogg
*.flac
*.webm
tmp_audio/

# Logs
logs/*
!logs/.gitkeep
*.log

# Exception: run evidence logs saved as .txt in docs/deployment/runs/ are tracked
!docs/deployment/runs/*.txt

# IDE & OS & Tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
.aider-desk/

# Test & Coverage
.coverage
htmlcov/
.pytest_cache/

# Phase 12 hardening (additional audio, vector indexes, DBs, CI coverage, scratch dirs)
*.m4a
*.opus
*.faiss
*.db
*.sqlite
*.sqlite3
coverage.xml
tmp/

# English ASR eval: original human recordings must never be committed
data/english_asr_eval/audio/
