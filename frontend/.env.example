# VoiceSense AI — Frontend Environment Variables (Phase 9b)

# Base URL for the FastAPI backend REST API (health, auth, history)
VITE_API_URL=http://127.0.0.1:8000

# WebSocket URL for real-time speech perception & synthesis streaming
VITE_WS_URL=ws://127.0.0.1:8000/ws/speech

# Whether authentication is mandatory on startup ('true' or 'false')
# When true, the client prompts for login/registration before starting sessions
VITE_AUTH_REQUIRED=false

# English-only ASR MVP mode ('true' default; set 'false' only when backend ASR_ENGLISH_ONLY=false)
# Hides Hindi/Indic selector options to match backend language-hint validation
VITE_ASR_ENGLISH_ONLY=true
