# ==============================================================================
# SenseAI Secrets Template (NEVER COMMIT REAL SECRETS)
# ==============================================================================
# Copy this file to a secure production location or vault:
#   cp security/secrets.example/env.secrets.example /etc/senseai/.env.secrets
# Ensure strict file system permissions:
#   chmod 600 /etc/senseai/.env.secrets
# ==============================================================================

# 1. JWT Signing Key (HMAC-SHA256)
# Minimum 32 bytes / 256 bits of high-entropy randomness.
# Generate via: openssl rand -base64 32
JWT_SECRET=PLACEHOLDER_OPENSSL_RAND_BASE64_32_CHARS_MINIMUM

# Enforce JWT handshake verification in production
REQUIRE_AUTH=true

# 2. Database Passwords (Production PostgreSQL)
DB_USER=senseai_app
DB_PASSWORD=PLACEHOLDER_SECURE_RANDOM_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=senseai_prod

# 3. Model & External API Keys (If any hybrid integrations enabled)
# Keep blank for 100% local operation
HUGGINGFACE_HUB_TOKEN=PLACEHOLDER_HF_READ_TOKEN_OPTIONAL

# 4. Session & Quota Settings
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_UTTERANCES_PER_MINUTE=20
MAX_UTTERANCE_DURATION_SECONDS=30.0
MAX_RAG_UPLOAD_SIZE_BYTES=10485760
