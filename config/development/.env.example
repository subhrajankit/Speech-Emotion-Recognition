# ==============================================================================
# Development Environment (.env.example) - Phase 1 Minimum Voice Loop
# ==============================================================================

# Server Network Settings (Localhost Only)
HOST=127.0.0.1
PORT=8000
DEBUG=true

# llama.cpp OpenAI-Compatible Server Endpoint
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_NAME=qwen3-1.7b
LLM_ENABLE_THINKING=false


# Audio & Speech Models
VAD_MODEL_PATH=models/silero_vad.onnx
VAD_THRESHOLD=0.5
SILENCE_TIMEOUT_MS=700

SENSEVOICE_MODEL_ID=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu
INDIC_CONFORMER_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
INDIC_CONFORMER_DEVICE=cpu
PARLER_TTS_MODEL_ID=ai4bharat/indic-parler-tts
PARLER_TTS_DEVICE=cpu

# Database configuration
DATABASE_PATH=database/dev.db

# Test & Mock Mode (Set to true to run tests without model checkpoints)
MOCK_MODELS=false

# Security & Authentication (Phase 11)
JWT_SECRET=senseai-dev-secret-key-change-in-production-32bytesmin
REQUIRE_AUTH=false
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_UTTERANCES_PER_MINUTE=20
MAX_UTTERANCE_DURATION_SECONDS=30.0
MAX_RAG_UPLOAD_SIZE_BYTES=10485760

# Resilience & Error Handling (Phase 14)
LLM_MAX_RETRIES=2
LLM_BACKOFF_FACTOR=0.2
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15.0
TTS_MAX_RETRIES=2
MAX_CONCURRENT_GPU_CALLS=2

# Optional Cloud LLM Fallback (Phase 17)
# Options: 'local' (default: 100% private local Qwen3-1.7B) | 'cloud' (Google Gemini 3 Flash)
# Note: 'cloud' mode sends spoken transcripts to Google's API as an explicit opt-in comparison feature.
LLM_PROVIDER=local
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NAME=gemini-2.5-flash


