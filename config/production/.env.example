# ==============================================================================
# Production Environment (.env.example) - Phase 18 Cybersecurity Hardened
# ==============================================================================

# Server Network Settings
# Local processes MUST bind to 127.0.0.1 or VPC private IP only
HOST=127.0.0.1
PORT=8000
DEBUG=false

# llama.cpp server endpoint (bound strictly to local loopback or private VPC)
LLAMA_CPP_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL_NAME=qwen3-1.7b
LLAMA_TIMEOUT_SECONDS=30.0

# Transport Security Invariant:
# Production requires TLS 1.3 termination at the reverse proxy (Nginx/Cloudflare).
# Clients MUST connect using wss:// (WebSocket Secure) and WebTransport over HTTP/3 (QUIC + TLS 1.3).
# Plain unencrypted ws:// or unencrypted WebTransport is rejected at the ingress gateway.
WEBSOCKET_PROTOCOL=wss
WEBTRANSPORT_TLS_ENABLED=true

# Security & Authentication (Phase 11 & Phase 18)
# REQUIRE_AUTH MUST be true in production
REQUIRE_AUTH=true
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_BYTES_HEX_OR_BASE64
JWT_ALGORITHM=HS256
SESSION_TIMEOUT_MINUTES=60

# Database Field-Level Encryption at Rest (Phase 18 AES-128-CBC Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_BASE64_32_BYTES

# Rate Limiting & Resource Quotas
RATE_LIMIT_UTTERANCES_PER_MINUTE=20
MAX_UTTERANCE_DURATION_SECONDS=30.0
MAX_RAG_UPLOAD_SIZE_BYTES=10485760

# Audit Logging (Tamper-Evident Hash Chain)
AUDIT_LOG_PATH=logs/audit.log

# Database Connection (PostgreSQL for production)
DATABASE_URL=postgresql://senseai_user:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/senseai_prod

# Resilience & Error Handling
LLM_MAX_RETRIES=2
LLM_BACKOFF_FACTOR=0.2
LLM_CIRCUIT_BREAKER_FAILURES=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=15.0
TTS_MAX_RETRIES=2
MAX_CONCURRENT_GPU_CALLS=2

# Audio Models
VAD_MODEL_PATH=models/silero_vad.onnx
SENSEVOICE_MODEL_ID=iic/SenseVoiceSmall
INDIC_CONFORMER_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
PARLER_TTS_MODEL_ID=ai4bharat/indic-parler-tts

# Fallback Flag
MOCK_MODELS=false
LLM_PROVIDER=local
