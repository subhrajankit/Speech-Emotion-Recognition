# ==============================================================================
# SenseAI Voice Assistant — Production Backup Configuration (Phase 15)
# ==============================================================================

# Backup storage location
BACKUP_DIR=/var/backups/senseai

# Database engine selection: 'sqlite' or 'postgres'
DB_TYPE=postgres

# SQLite Configuration (if DB_TYPE=sqlite)
DATABASE_PATH=database/production.db

# PostgreSQL Configuration (if DB_TYPE=postgres)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=senseai
POSTGRES_USER=senseai

# FAISS Vector Index and Document Source directories
RAG_INDEX_DIR=data/index
RAG_DOCS_DIR=data/documents

# Retention & Pruning Windows
BACKUP_RETENTION_DAYS=14
DATA_RETENTION_DAYS=30
