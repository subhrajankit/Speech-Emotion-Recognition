# ==============================================================================
# VoiceSense AI — Environment Configuration (.env.example)
# Copy to .env and customize for development or production Docker Compose.
# Never commit real passwords, JWT secrets, or HF_TOKEN values to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Network Settings
# ------------------------------------------------------------------------------
APP_ENV=development
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true
# CSV or JSON list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1,http://localhost

# ------------------------------------------------------------------------------
# Logging & Privacy Policy (Raw audio is never persisted)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
STORE_TRANSCRIPTS=true

# ------------------------------------------------------------------------------
# Security, Authentication & Rate Limits
# ------------------------------------------------------------------------------
# Production (APP_ENV=production or ENVIRONMENT=production) refuses to start on
# default/weak JWT_SECRET (<32 chars) or AUTH_REQUIRED=false. Keep false for local dev only.
AUTH_REQUIRED=false
JWT_SECRET=voicesense-dev-only-secret-change-in-prod-min-32-bytes
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_UTTERANCES_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_UTTERANCE_DURATION_SECONDS=30.0
MAX_RAG_UPLOAD_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE_BYTES=10485760
WS_MAX_BUFFER_BYTES=5242880

# ------------------------------------------------------------------------------
# Database (SQLite dev default vs PostgreSQL prod)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./database/dev.db

# PostgreSQL variables used by deployment/docker-compose.prod.yml
# Must be set before starting prod compose (compose fails fast if missing)
POSTGRES_USER=voicesense
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=voicesense

# Optional: PostgreSQL test harness DSN (pytest tests/backend/test_postgres_compatibility.py)
# DATABASE_URL_TEST=postgresql+psycopg://voicesense:change-me@127.0.0.1:5432/voicesense_test

# ------------------------------------------------------------------------------
# Speech Perception Models (ASR, VAD, Language Routing)
# English-only MVP: ASR_ENGLISH_ONLY=true disables IndicConformer and Tier-2 LID.
# Set false to re-enable multilingual routing (requires IndicConformer + optional VoxLingua107).
# ------------------------------------------------------------------------------
INFERENCE_CONCURRENCY_LIMIT=2
VAD_THRESHOLD=0.5
SILERO_VAD_MODEL_PATH=models/silero_vad.onnx
SILERO_VAD_THRESHOLD=0.5

# SenseVoiceSmall (zh, en, yue, ja, ko + English/CJK emotion tags)
SENSEVOICE_MODEL_DIR=iic/SenseVoiceSmall
SENSEVOICE_DEVICE=cpu
SENSEVOICE_THREADS=4
ASR_ENGLISH_ONLY=true

# IndicConformer-600m (Hindi ASR when language_hint="hi"; emotion remains null)
# Requires approved HF_TOKEN passed at runtime via host env for initial download
INDICCONFORMER_MODEL_DIR=ai4bharat/indic-conformer-600m-multilingual
INDICCONFORMER_REVISION=2a77d305038dfc502fd9464e7d028b90381976cb
INDICCONFORMER_DEVICE=cpu
INDICCONFORMER_DECODER_TYPE=ctc
LID_CONFIDENCE_THRESHOLD=0.6
# Tier-2 spoken LID (VoxLingua107). Default off: unhinted utterances use
# SenseVoice. When true, local checkpoints in LID_MODEL_DIR are required
# (no downloads) and speechbrain/hyperpyyaml must be installed (ml.txt).
LID_ENABLED=false
LID_MODEL_DIR=models/voxlingua107

# Lazy loading defers ~3.75 GB IndicConformer load until language_hint="hi" is sent
LAZY_LOAD_MODELS=true
PRELOAD_DEFAULT_ENGINE=false

# ------------------------------------------------------------------------------
# Memory-Light Override Reference (Single-Engine Lazy Mode for ~8 GB WSL2 hosts)
# Keep IndicConformer unloaded by only using Auto/English; avoids Hindi model RAM
# Apply automatically via:
#   docker compose -f docker-compose.yml -f deployment/docker-compose.memory-light.yml up
# ------------------------------------------------------------------------------
# LAZY_LOAD_MODELS=true
# PRELOAD_DEFAULT_ENGINE=false
# SENSEVOICE_THREADS=2
# INFERENCE_CONCURRENCY_LIMIT=1
# BACKEND_MEM_LIMIT=4g

# ------------------------------------------------------------------------------
# Local LLM Service (Qwen3-1.7B via llama.cpp server)
# Backend starts and serves ASR/emotion normally even if LLM is stopped or down
# ------------------------------------------------------------------------------
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL_NAME=qwen3-1.7b
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.7
LLM_REPEAT_PENALTY=1.1
LLM_FREQUENCY_PENALTY=0.2
LLM_PRESENCE_PENALTY=0.0
LLM_ENABLE_THINKING=false
LLM_HEALTH_CACHE_SECONDS=5.0
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=15.0

# Compose LLM container runtime parameters (filename inside mounted ./models)
LLM_MODEL_FILE=qwen3-1.7b.gguf
LLM_CTX_SIZE=4096
LLM_GPU_LAYERS=24
BACKEND_MEM_LIMIT=12g
LLM_MEM_LIMIT=3g

# ------------------------------------------------------------------------------
# Text-to-Speech (Disabled in Docker containers; out of scope for Phase 11)
# ------------------------------------------------------------------------------
TTS_ENABLED=false
TTS_MODEL_ID=ai4bharat/indic-parler-tts
TTS_DEVICE=auto
TTS_DTYPE=float16
TTS_SAMPLE_RATE=44100
TTS_EMOTION_STYLING_ENABLED=false
TTS_DEFAULT_SPEAKER=Aditi
TTS_MAX_SENTENCE_LENGTH=500
TTS_CONCURRENCY_LIMIT=1
TTS_SENTENCE_TIMEOUT_SECONDS=30.0
TTS_COOLDOWN_SECONDS=60.0
TTS_WORKER_PYTHON=.venv-tts/Scripts/python.exe

# ------------------------------------------------------------------------------
# Runtime Secret Placeholders (Do NOT store real tokens in committed files)
# Export HF_TOKEN in your shell before running docker compose up when fetching gated models:
#   PowerShell: $env:HF_TOKEN="hf_..."
#   Bash:       export HF_TOKEN="hf_..."
# Leave empty unless downloading gated HF models (never commit a real token to git).
# ------------------------------------------------------------------------------
HF_TOKEN=

# ------------------------------------------------------------------------------
# Frontend Build-Time Variables (Vite bakes these at npm run build)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/speech
VITE_AUTH_REQUIRED=false
VITE_ASR_ENGLISH_ONLY=true
