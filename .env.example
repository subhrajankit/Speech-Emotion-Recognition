# ==============================================================================
# SenseAI Voice Assistant - Environment Configuration (.env.example)
# ==============================================================================

# Server Environment
APP_ENV=development
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Model Serving Endpoints & Bindings (Localhost Only)
LLAMA_CPP_SERVER_HOST=127.0.0.1
LLAMA_CPP_SERVER_PORT=8080
LLAMA_MODEL_PATH=./models/qwen3-4b.gguf
LLAMA_N_CTX=4096
LLAMA_N_GPU_LAYERS=33

# Audio & Speech Models
VAD_MODEL_PATH=./models/silero_vad.onnx
SENSEVOICE_MODEL_DIR=./models/SenseVoiceSmall
INDIC_CONFORMER_MODEL_DIR=./models/indic_conformer_600m
PARLER_TTS_MODEL_DIR=./models/indic-parler-tts
TTS_DEVICE=auto
TTS_DTYPE=float16


# RAG & Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-small
FAISS_INDEX_PATH=./database/vector_index.faiss
DOCUMENTS_STORE_PATH=./database/documents

# Database Settings
DATABASE_URL=sqlite:///./database/dev.db
# Database (Production Postgres)
# DATABASE_URL=postgresql://senseai:password@localhost:5432/senseai_prod
STORE_TRANSCRIPTS=true

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/senseai.log
ENABLE_METRICS=true
METRICS_PORT=9090

# Security & Authentication
JWT_SECRET=senseai-dev-secret-key-change-in-production-32bytesmin
AUTH_REQUIRED=false
REQUIRE_AUTH=false
SESSION_TIMEOUT_MINUTES=60
RATE_LIMIT_UTTERANCES_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
MAX_UTTERANCE_DURATION_SECONDS=30.0
MAX_RAG_UPLOAD_SIZE_BYTES=10485760
WS_MAX_BUFFER_BYTES=5242880

